# ───────────────────────── LifeDrop environment ─────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Database — SQLite for local dev. For production use PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lifedrop?schema=public"
#   (and set provider = "postgresql" in prisma/schema.prisma — see DATABASE.md)
DATABASE_URL="file:./dev.db"

# Public base URL (used in emails, CSRF origin check, sitemap)
APP_URL="http://localhost:3000"

# Auth — REQUIRED in production, at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
SESSION_DAYS=7

# Scheduler — protect /api/cron/run. Set RUN_JOBS_IN_PROCESS=false on serverless hosts.
CRON_SECRET=""
RUN_JOBS_IN_PROCESS=true

# Web Push (VAPID) — generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.org"

# Email (SMTP). Leave SMTP_HOST empty to log emails to the server console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="LifeDrop <no-reply@example.org>"

# SMS — "console" logs messages; "twilio" uses the Twilio REST API.
# Future providers (local BD gateways, WhatsApp) plug into src/server/notify/channels.ts.
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# File storage for avatars (local disk). Swap for object storage in production.
UPLOAD_DIR="./uploads"

# City timezone (single-city deployment)
NEXT_PUBLIC_TZ="Asia/Dhaka"
NEXT_PUBLIC_TZ_OFFSET_MINUTES=360

# Optional: Google Maps embed. Without it the app uses OpenStreetMap (no key needed).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Development only: include verification links / OTP codes in API responses.
EXPOSE_DEV_SECRETS=true
